# Copia este archivo a .env.local y completa los valores.
# Ver supabase/SETUP.md para los pasos exactos de dónde sacar cada uno.

# ── Supabase (nuevo) ─────────────────────────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# ⚠️ SIN prefijo VITE_ a propósito — esta key puede saltarse toda la
# seguridad de RLS. Solo la usan las funciones serverless en /api. Nunca la
# expongas al navegador ni la subas a git.
SUPABASE_SERVICE_ROLE_KEY=

# ── Pagos (sin cambios) ──────────────────────────────────────────────────────
VITE_CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=
MP_ACCESS_TOKEN=

# ── Firebase (TEMPORAL) ───────────────────────────────────────────────────────
# Todavía en uso mientras se termina de migrar el login (AuthContext.jsx) y
# los webhooks de pago a Supabase Auth — ver conversación. Se eliminan por
# completo cuando esa fase quede lista.
VITE_API_KEY=
VITE_AUTH_DOMAIN=
VITE_PROJECT_ID=
VITE_STORAGE_BUCKET=
VITE_MESSAGING_SENDER_ID=
VITE_APP_ID=
VITE_MEASUREMENT_ID=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
